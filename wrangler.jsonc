{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-portfolio",
  "compatibility_date": "2026-08-04",
  "main": "./worker/index.ts",

  // No "directory" key: @cloudflare/vite-plugin populates assets.directory
  // with the client build output automatically. Setting it by hand would
  // fight the plugin.
  "assets": {
    // Serves index.html with a 200 for any path that is not a real file,
    // so React Router owns client-side routes on hard refresh and deep
    // links. This replaces the Pages-era `/* /index.html 200` rule in
    // public/_redirects.
    "not_found_handling": "single-page-application",

    // Without this, /api/contact would match the SPA fallback above and
    // return the app shell instead of reaching the Worker.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Non-secret defaults. On Workers, `wrangler deploy` reconciles plain
  // vars from this file, so they must live here rather than in the
  // dashboard. Secrets are separate and are NOT overwritten by a deploy:
  //   npx wrangler secret put RESEND_API_KEY
  "vars": {
    "CONTACT_TO_EMAIL": "ihsan@ihsanhadhrami.com",
    "CONTACT_FROM_EMAIL": "hello@ihsanhadhrami.com"
  }
}
