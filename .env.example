# Public site metadata (safe to expose to the client)
VITE_SITE_URL="https://ihsanhadhrami.com"

# The contact form posts to the Worker in worker/index.ts. Its
# RESEND_API_KEY / CONTACT_TO_EMAIL / CONTACT_FROM_EMAIL are server-side
# only — see wrangler.jsonc for the vars and `wrangler secret put` for the
# key, or .dev.vars for local runs. Never put them here: every
# VITE_-prefixed variable is inlined into the browser bundle.
