# Public site metadata (safe to expose to the client)
VITE_SITE_URL="https://ihsanhadhrami.com"

# The contact form posts to the Cloudflare Pages Function in
# functions/api/contact.ts. Its RESEND_API_KEY / CONTACT_TO_EMAIL /
# CONTACT_FROM_EMAIL are server-side only — set them in the Cloudflare
# dashboard, or in .dev.vars for `wrangler pages dev`. Never put them here:
# every VITE_-prefixed variable is inlined into the browser bundle.
